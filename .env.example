# Run node scripts/setup.mjs to create a private .env interactively.
# One owner account; no ChatGPT/Sites sign-in is used by this edition.
APP_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
INGEST_API_TOKEN=
DATA_DIR=./var
# Optional services; keys stay on the server.
PARALLEL_API_KEY=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MINIMAX_API_KEY=
MINIMAX_VOICE_ID=
MINIMAX_MODEL=speech-2.8-turbo
