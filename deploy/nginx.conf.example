# Replace molbrief.example.com with your domain. Obtain the certificate before
# enabling the HTTPS server block. Keep the ACME webroot for certificate renewal.
server {
    listen 80;
    server_name molbrief.example.com;
    client_max_body_size 128k;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/molbrief-acme;
        try_files $uri =404;
    }
    location / {
        return 301 https://molbrief.example.com$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name molbrief.example.com;
    ssl_certificate /etc/letsencrypt/live/molbrief.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/molbrief.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 128k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_buffering off;
        proxy_cache off;
    }
}
